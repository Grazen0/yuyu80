    .ifndef SYSTEM_INC
    .define SYSTEM_INC

ROM_START equ $0000
ROM_SIZE equ $8000
ROM_END equ ROM_START + ROM_SIZE

RAM_START equ $8000
RAM_SIZE equ $8000
RAM_END equ RAM_START + RAM_SIZE

SYS_CLK equ 4000000

TIMER_FREQ equ 1000
TIMER_TIME_CONST equ SYS_CLK / (16 * TIMER_FREQ)
    .assert TIMER_TIME_CONST != 0

SIO_BAUD_RATE equ 1200
SIO_CLK_FREQ equ 16 * SIO_BAUD_RATE
SIO_TIME_CONST equ SYS_CLK / (16 * SIO_CLK_FREQ)
    .assert SIO_TIME_CONST

LCD_CTRL equ $00
LCD_DATA equ $01

PIO_DATA_A equ $40
PIO_CTRL_A equ $41
PIO_DATA_B equ $42
PIO_CTRL_B equ $43

CTC_CH0 equ $80
CTC_CH1 equ $81
CTC_CH2 equ $82
CTC_CH3 equ $83

SIO_DATA_A equ $C0
SIO_CTRL_A equ $C1
SIO_DATA_B equ $C2
SIO_CTRL_B equ $C3

    .endif
